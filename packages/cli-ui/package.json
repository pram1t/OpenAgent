{
  "name": "@pram1t/mustard-cli-ui",
  "version": "1.0.0-rc.7",
  "description": "Visual identity primitives for Mustard CLI — banner, theme, box, spinner, status, prompt.",
  "author": "pram1t",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pram1t/Mustard.git",
    "directory": "packages/cli-ui"
  },
  "homepage": "https://github.com/pram1t/Mustard#readme",
  "bugs": {
    "url": "https://github.com/pram1t/Mustard/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/assets', 'dist/assets', {recursive: true})\"",
    "dev": "tsc --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "boxen": "^7.1.1",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "log-update": "^6.1.0",
    "ora": "^7.0.1",
    "picocolors": "^1.0.1",
    "supports-color": "^9.4.0",
    "terminal-link": "^3.0.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^25.0.9",
    "typescript": "^5.9.3"
  }
}
