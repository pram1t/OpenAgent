{
  "name": "@pram1t/mustard-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Mustard Desktop application",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "sbom": "cyclonedx-npm --output-format json --output-file sbom.json",
    "pack": "electron-builder --config electron-builder.yml --dir",
    "dist": "electron-builder --config electron-builder.yml",
    "dist:win": "electron-builder --config electron-builder.yml --win",
    "dist:mac": "electron-builder --config electron-builder.yml --mac",
    "dist:linux": "electron-builder --config electron-builder.yml --linux",
    "audit:native": "npx tsx scripts/audit-native-modules.ts",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11",
    "@pram1t/mustard-config": "*",
    "@pram1t/mustard-core": "*",
    "@pram1t/mustard-llm": "*",
    "@pram1t/mustard-mcp": "*",
    "@pram1t/mustard-tools": "*"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "34.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^4.0.1",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3"
  }
}
